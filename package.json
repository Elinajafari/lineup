{
  "name": "lineup",
  "private": true,
  "version": "1.0.0",
  "description": "Lineup: concert tickets refunded in full when GenLayer validators agree an announced change to the show is material.",
  "type": "module",
  "license": "MIT",
  "author": "Elina (https://github.com/Elinajafari)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elinajafari/lineup"
  },
  "scripts": {
    "test": "pnpm -r --sequential test",
    "test:contract": "pnpm --filter @lineup/contracts test",
    "test:shared": "pnpm --filter @lineup/shared test",
    "typecheck": "pnpm --filter @lineup/shared typecheck",
    "mutate:contract": "pnpm --filter @lineup/contracts mutate",
    "measure:contract": "pnpm --filter @lineup/contracts measure",
    "lint:genvm": "node packages/contracts/scripts/lint.mjs",
    "deploy:contract": "node packages/contracts/scripts/deploy.mjs",
    "seed:contract": "node packages/contracts/scripts/seed.mjs",
    "seed:activity": "node packages/contracts/scripts/seed-activity.mjs",
    "e2e:contract": "node packages/contracts/scripts/e2e.mjs",
    "verify:contract": "node packages/contracts/scripts/verify.mjs",
    "evidence:contract": "node packages/contracts/scripts/evidence.mjs",
    "evidence:activity": "node packages/contracts/scripts/evidence.mjs packages/contracts/deployments/studionet-activity.json EVIDENCE-ACTIVITY.md \"Lineup, second round\"",
    "demo:contract": "pnpm deploy:contract && pnpm seed:contract && pnpm e2e:contract && pnpm evidence:contract"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.2"
}
